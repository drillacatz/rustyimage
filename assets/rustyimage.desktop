[Desktop Entry]
Name=RustyImage
Comment=Fast, minimalist local image and animation converter in pure Rust
Exec=rustyimage %F
Icon=rustyimage
Terminal=false
Type=Application
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/vnd.microsoft.icon;image/x-icon;image/tiff;image/x-tga;image/svg+xml;
StartupNotify=true
